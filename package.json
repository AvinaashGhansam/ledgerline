{
  "name": "ledgerline",
  "version": "0.1.0",
  "description": "A double-entry ledger API.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  }
}
